// Cloudflare settings for the site. Cloudflare reads this when it builds from GitHub.
{
  "name": "kaminari-site",
  "main": "worker.js",
  "compatibility_date": "2026-10-01",
  // the addresses this site answers on; keeping them here means every deploy re-confirms them
  "routes": [
    { "pattern": "www.joinkaminari.com", "custom_domain": true },
    { "pattern": "joinkaminari.com", "custom_domain": true }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // unknown addresses show dist/404.html
    "not_found_handling": "404-page",
    // everything is served as a plain file except the /api addresses
    "run_worker_first": ["/api/*"]
  },
  // Arc Tracker notifications: where device subscriptions are stored, and the timer that sends reminders
  "kv_namespaces": [
    { "binding": "ARC_PUSH", "id": "72b27370d6d847e6a9cec0ddc94b867e" }
  ],
  "triggers": { "crons": ["*/5 * * * *"] },
  "vars": {
    // the public half of the notification signing key (the private half is a secret on the Worker)
    "VAPID_PUBLIC_KEY": "BAkS38uc8FNh2pXTCMH8Y8dNzqLbKLSo_gdIfD0We3TfCcZCzGGAD7agRNTlJ3a3Nlj42MytgNIGnZFiHS0H0TM",
    "VAPID_SUBJECT": "mailto:contact@joinkaminari.com"
  }
}
