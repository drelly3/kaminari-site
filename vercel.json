{
  "buildCommand": "node build.mjs",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/media/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "joinkaminari.com"
        }
      ],
      "destination": "https://www.joinkaminari.com/",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "joinkaminari.com"
        }
      ],
      "destination": "https://www.joinkaminari.com/:path*",
      "permanent": true
    },
    {
      "source": "/arc-tracker",
      "destination": "/arc-tracker/app",
      "permanent": false
    }
  ]
}
