// Isolated preview Worker for The Anime Mindset. Static assets only: no Worker code, no bindings,
// no KV/R2/D1, no routes and no custom domain. Served only on its workers.dev URL.
// Separate from the joinkaminari.com production Worker (../wrangler.jsonc, "kaminari-site"), which this file does not touch.
// Deploy from the repo root:  npx wrangler@4.156.2 deploy -c animemindset-site/wrangler.jsonc
{
  "name": "animemindset-preview",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "."
  }
}
